# Example host nginx site — does NOT replace your other project's config.
# Save as: /etc/nginx/sites-available/decozr.conf
# Then: ln -s /etc/nginx/sites-available/decozr.conf /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx
#
# Change server_name to your subdomain, e.g. decozr.yourdomain.com

server {
    listen 80;
    server_name decozr.example.com;

    client_max_body_size 40m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
